GEMINI_API_KEY=
# Optional overrides. By default the worker and the help chat use the eval's picks in
# _shared/models.ts (npm run eval:publicus). An override runs at low thinking.
GEMINI_MODEL=
GEMINI_CHAT_MODEL=
# Exact website origins, comma separated. Add your preview origin explicitly when testing.
ALLOWED_ORIGINS=http://localhost:3001,https://www.rafeed.dev,https://rafeed.dev
# Generate a random secret; use the same value in Vault publicus_worker_secret.
PUBLICUS_WORKER_SECRET=
# Daily caps across all anonymous workspaces. Each run reserves before a model call.
PUBLICUS_AI_DAILY_LIMIT=100
# Daily cap on help-chat questions across all visitors (each visitor also gets 20 a day).
PUBLICUS_CHAT_DAILY_LIMIT=200
# Daily cap on uploads across all visitors (each visitor also gets 10 a day). Files stay up to seven days.
PUBLICUS_UPLOAD_DAILY_LIMIT=50
